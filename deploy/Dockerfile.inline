FROM nginx:1.27-alpine
RUN : > /tmp/s.b64 && printf %s "" >> /tmp/s.b64 && printf %s "" >> /tmp/s.b64 && printf %s "" >> /tmp/s.b64 && printf %s "" >> /tmp/s.b64 && printf %s "" >> /tmp/s.b64 && printf %s "" >> /tmp/s.b64 && printf %s "" >> /tmp/s.b64 && printf %s "" >> /tmp/s.b64 && printf %s "" >> /tmp/s.b64 && printf %s "" >> /tmp/s.b64 && printf %s "" >> /tmp/s.b64 && base64 -d /tmp/s.b64 | gunzip > /usr/share/nginx/html/index.html && rm /tmp/s.b64
EXPOSE 80
