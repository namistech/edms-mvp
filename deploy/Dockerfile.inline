FROM nginx:1.27-alpine
RUN printf "server {\n listen 80;\n root /usr/share/nginx/html;\n add_header X-Robots-Tag \"noindex\";\n location / { try_files \$uri /index.html; }\n}\n" > /etc/nginx/conf.d/default.conf
RUN : > /tmp/s.b64 && printf %s "" >> /tmp/s.b64 && printf %s "" >> /tmp/s.b64 && printf %s "" >> /tmp/s.b64 && printf %s "" >> /tmp/s.b64 && printf %s "" >> /tmp/s.b64 && printf %s "" >> /tmp/s.b64 && printf %s "" >> /tmp/s.b64 && printf %s "" >> /tmp/s.b64 && printf %s "" >> /tmp/s.b64 && base64 -d /tmp/s.b64 | gunzip > /usr/share/nginx/html/index.html && rm /tmp/s.b64
EXPOSE 80
